# ==========================================================================
#  환경변수 양식 파일
#  1) 이 파일을 복사해서 이름을 .env.local 로 바꾸세요. (이 파일 자체는 그대로 두기)
#  2) = 뒤에 값을 붙여넣으세요. (띄어쓰기, 따옴표 없이)
#  3) 저장 후 개발 서버를 껐다 켜세요. (Ctrl + C → npm run dev)
#
#  ⚠ .env.local 은 비밀 파일입니다. GitHub에 올라가지 않게 설정되어 있고,
#    다른 사람에게 보내거나 캡처해서 공유하지 마세요.
# ==========================================================================

# 관리자 페이지(/admin) 비밀번호 — 원하는 값으로
ADMIN_PASSWORD=

# ---- Supabase (3차시에 연결) ----
# Supabase 대시보드 → Project Settings → Data API 의 Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 대시보드 → Project Settings → API Keys
# Publishable key (sb_publishable_ 로 시작)  ※ 예전 이름: anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_ 로 시작)  ※ 예전 이름: service_role key
# 절대 공개 금지! (NEXT_PUBLIC_ 이 붙지 않은 이유)
SUPABASE_SECRET_KEY=
